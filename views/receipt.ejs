<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Plus Jakarta Sans', 'Courier New', monospace;
      background: #f0f2f5;
      display: flex;
      justify-content: center;
      padding: 40px 20px;
    }
    .receipt-container {
      width: 360px;
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 10px 40px rgba(0,0,0,0.08);
      padding: 32px 28px;
    }
    .receipt-header {
      text-align: center;
      border-bottom: 2px dashed #e2e8f0;
      padding-bottom: 20px;
      margin-bottom: 20px;
    }
    .receipt-header h1 { font-size: 20px; font-weight: 700; color: #0f172a; }
    .receipt-header .school { font-size: 13px; color: #17C9FF; font-weight: 600; margin-top: 4px; }
    .receipt-header .invoice { font-size: 13px; color: #64748b; margin-top: 4px; }
    .receipt-header .date { font-size: 12px; color: #94a3b8; margin-top: 2px; }
    .receipt-divider { border: none; border-top: 1px dashed #e2e8f0; margin: 12px 0; }
    .receipt-item { display: flex; justify-content: space-between; font-size: 14px; padding: 4px 0; }
    .receipt-item .name { flex: 1; color: #1e293b; }
    .receipt-item .qty { color: #64748b; width: 40px; text-align: center; }
    .receipt-item .price { color: #1e293b; font-weight: 500; width: 100px; text-align: right; }
    .receipt-summary { margin-top: 16px; border-top: 2px dashed #e2e8f0; padding-top: 16px; }
    .summary-line { display: flex; justify-content: space-between; font-size: 14px; padding: 4px 0; color: #475569; }
    .summary-line.total { font-size: 18px; font-weight: 700; color: #0f172a; border-top: 1px solid #e2e8f0; padding-top: 12px; margin-top: 8px; }
    .summary-line.positive { color: #10b981; }
    .payment-info { margin-top: 16px; padding-top: 16px; border-top: 2px dashed #e2e8f0; font-size: 13px; color: #64748b; }
    .payment-info span { display: block; text-align: center; }
    .receipt-footer { margin-top: 20px; text-align: center; border-top: 2px dashed #e2e8f0; padding-top: 20px; }
    .receipt-footer p { font-size: 12px; color: #94a3b8; }
    .btn-print {
      display: block;
      width: 100%;
      padding: 12px;
      margin-top: 16px;
      background: #17C9FF;
      color: white;
      border: none;
      border-radius: 12px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      font-family: inherit;
      transition: all 0.2s;
    }
    .btn-print:hover { background: #0fb5e8; transform: translateY(-1px); }
    @media print {
      body { background: white; padding: 0; }
      .receipt-container { box-shadow: none; border: none; padding: 20px; }
      .btn-print { display: none; }
    }
  </style>
</head>
<body>
  <div class="receipt-container" id="receiptPrint">
    <div class="receipt-header">
      <h1>Gspro</h1>
      <div class="school">SMK Jakarta Pusat 1</div>
      <div class="invoice">#<%= transaction.invoice_number %></div>
      <div class="date"><%= new Date(transaction.created_at).toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></div>
    </div>

    <% details.forEach(item => { %>
      <div class="receipt-item">
        <span class="name"><%= item.product_name %></span>
        <span class="qty">x<%= item.qty %></span>
        <span class="price">Rp <%= Number(item.subtotal).toLocaleString('id-ID') %></span>
      </div>
    <% }) %>

    <div class="receipt-summary">
      <div class="summary-line">
        <span>Subtotal</span>
        <span>Rp <%= Number(transaction.subtotal).toLocaleString('id-ID') %></span>
      </div>
      <div class="summary-line total">
        <span>Total</span>
        <span>Rp <%= Number(transaction.total_amount).toLocaleString('id-ID') %></span>
      </div>
      <% if (transaction.payment_method === 'cash') { %>
        <div class="summary-line">
          <span>Tunai</span>
          <span>Rp <%= Number(transaction.cash_paid).toLocaleString('id-ID') %></span>
        </div>
        <div class="summary-line positive">
          <span>Kembalian</span>
          <span>Rp <%= Number(transaction.change_amount).toLocaleString('id-ID') %></span>
        </div>
      <% } %>
    </div>

    <div class="payment-info">
      <span>Metode Pembayaran: <strong><%= transaction.payment_method === 'cash' ? 'Tunai' : 'QRIS' %></strong></span>
    </div>

    <div class="receipt-footer">
      <p>Terima kasih telah berbelanja!</p>
      <p>Barang yang sudah dibeli tidak dapat ditukar</p>
      <button class="btn-print" onclick="window.print()">
        <i class="fas fa-print"></i> Cetak / Simpan PDF
      </button>
    </div>
  </div>
</body>
</html>
